# Limites do gdlint: Main.gd e GameState.gd são os hubs centrais do jogo
# (coordenação da cena e persistência) e concentram a API pública por design.
# Pós-dinâmica 2026-09-21: progressive disclosure (+~150L) elevou HUD e Meta —
# limite afrouxado para não mascarar regressão lógica real.
max-public-methods: 42
max-file-lines: 1350
